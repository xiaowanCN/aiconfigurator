# ============================================================================
# Collector Dockerfile for GPU Performance Data Collection
# ============================================================================
# This Dockerfile builds images for collecting performance data on target GPUs.
# Each backend (sglang, trtllm, vllm) requires its own framework container
# because the collector scripts invoke framework-specific CUDA kernels.
#
# Usage:
#   # Build SGLang collector
#   docker build -f docker/Dockerfile.collector --target collector-sglang -t collector-sglang .
#
#   # Build TRT-LLM collector
#   docker build -f docker/Dockerfile.collector --target collector-trtllm -t collector-trtllm .
#
#   # Build vLLM collector
#   docker build -f docker/Dockerfile.collector --target collector-vllm -t collector-vllm .
#
#   # Run collector (example: B300 SGLang)
#   docker run -it --gpus all --ipc=host --network=host \
#     collector-sglang python3 collect.py --backend sglang --gpu b300_sxm

# ============================================================================
# SGLang Collector (with aiconfigurator CLI)
# ============================================================================
FROM lmsysorg/sglang:v0.5.14 AS collector-sglang

WORKDIR /workspace

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends git curl build-essential && \
    rm -rf /var/lib/apt/lists/*

# Install uv for Python package management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Install Rust toolchain for building aic-core (PyO3 extension)
ENV RUSTUP_HOME=/opt/rust/rustup \
    CARGO_HOME=/opt/rust/cargo \
    PATH=/opt/rust/cargo/bin:${PATH}

RUN curl --proto '=https' --tlsv1.2 -sSf --retry 5 --retry-connrefused --retry-delay 2 \
        https://sh.rustup.rs -o /tmp/rustup-init.sh \
    && sh /tmp/rustup-init.sh -y --profile minimal --default-toolchain 1.96.0 \
    && rm /tmp/rustup-init.sh

# Configure maturin for sparse protocol
ENV CARGO_REGISTRIES_CRATES_IO_PROTOCOL="sparse"

# Configure PyPI mirror (optional, can be removed if not needed)
ENV UV_INDEX_URL="https://pypi.tuna.tsinghua.edu.cn/simple"

# Copy complete project source for building aiconfigurator
COPY aic-core/ /workspace/aic-core/
COPY src/ /workspace/src/
COPY collector/ /workspace/collector/
COPY pyproject.toml README.md LICENSE /workspace/

# Verify Git LFS content is materialized
RUN set -e; \
    bad=$(grep -rlE "^version https://git-lfs" /workspace/aic-core/src/aiconfigurator_core/systems 2>/dev/null || true); \
    if [ -n "$bad" ]; then \
        echo "ERROR: Unmaterialized Git LFS pointer files found:" >&2; \
        echo "$bad" >&2; \
        echo "Run 'git lfs install && git lfs pull' in the source tree before building." >&2; \
        exit 1; \
    fi

# Install aic-core and aiconfigurator in development mode
RUN cd /workspace && \
    uv pip install --system --editable ./aic-core && \
    uv pip install --system --editable "."

# Set environment variables for SGLang
ENV FLASHINFER_LOG_LEVEL=ERROR
ENV SGLANG_LOAD_FORMAT=dummy
ENV COLLECTOR_LOG_DIR=/workspace/collector/logs

WORKDIR /workspace/collector

CMD ["/bin/bash"]

# ============================================================================
# TensorRT-LLM Collector (with aiconfigurator CLI)
# ============================================================================
FROM nvcr.io/nvidia/tensorrt-llm/release:1.3.0rc10 AS collector-trtllm

WORKDIR /workspace

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends git curl build-essential && \
    rm -rf /var/lib/apt/lists/*

# Install uv for Python package management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Install Rust toolchain for building aic-core (PyO3 extension)
ENV RUSTUP_HOME=/opt/rust/rustup \
    CARGO_HOME=/opt/rust/cargo \
    PATH=/opt/rust/cargo/bin:${PATH}

RUN curl --proto '=https' --tlsv1.2 -sSf --retry 5 --retry-connrefused --retry-delay 2 \
        https://sh.rustup.rs -o /tmp/rustup-init.sh \
    && sh /tmp/rustup-init.sh -y --profile minimal --default-toolchain 1.96.0 \
    && rm /tmp/rustup-init.sh

# Configure maturin for sparse protocol
ENV CARGO_REGISTRIES_CRATES_IO_PROTOCOL="sparse"

# Configure PyPI mirror (optional, can be removed if not needed)
ENV UV_INDEX_URL="https://pypi.tuna.tsinghua.edu.cn/simple"

# Copy complete project source for building aiconfigurator
COPY aic-core/ /workspace/aic-core/
COPY src/ /workspace/src/
COPY collector/ /workspace/collector/
COPY pyproject.toml README.md LICENSE /workspace/

# Verify Git LFS content is materialized
RUN set -e; \
    bad=$(grep -rlE "^version https://git-lfs" /workspace/aic-core/src/aiconfigurator_core/systems 2>/dev/null || true); \
    if [ -n "$bad" ]; then \
        echo "ERROR: Unmaterialized Git LFS pointer files found:" >&2; \
        echo "$bad" >&2; \
        echo "Run 'git lfs install && git lfs pull' in the source tree before building." >&2; \
        exit 1; \
    fi

# Install aic-core and aiconfigurator in development mode
RUN cd /workspace && \
    uv pip install --system --editable ./aic-core && \
    uv pip install --system --editable "."

# Set environment variables for TRT-LLM
ENV TLLM_LOG_LEVEL=ERROR
ENV TRTLLM_DG_ENABLED=1
ENV COLLECTOR_LOG_DIR=/workspace/collector/logs

WORKDIR /workspace/collector

CMD ["/bin/bash"]

# ============================================================================
# vLLM Collector (with aiconfigurator CLI)
# ============================================================================
