# ============================================================================
# Collector Dockerfile for GPU Performance Data Collection
# ============================================================================
# This Dockerfile builds images for collecting performance data on target GPUs.
# Each backend (sglang, trtllm, vllm) requires its own framework container
# because the collector scripts invoke framework-specific CUDA kernels.
#
# Usage:
#   # Build SGLang collector
#   docker build -f docker/Dockerfile.collector --target collector-sglang -t collector-sglang .
#
#   # Build TRT-LLM collector
#   docker build -f docker/Dockerfile.collector --target collector-trtllm -t collector-trtllm .
#
#   # Build vLLM collector
#   docker build -f docker/Dockerfile.collector --target collector-vllm -t collector-vllm .
#
#   # Run collector (example: B300 SGLang)
#   docker run -it --gpus all --ipc=host --network=host \
#     collector-sglang python3 collect.py --backend sglang --gpu b300_sxm

# ============================================================================
# SGLang Collector
# ============================================================================
FROM lmsysorg/sglang:v0.5.14 AS collector-sglang

WORKDIR /workspace

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends git curl && \
    rm -rf /var/lib/apt/lists/*

# Install uv for Python package management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Copy collector source code
COPY collector/ /workspace/collector/

# Copy system definitions (GPU specs, capabilities, denylist)
COPY aic-core/src/aiconfigurator_core/systems/*.yaml /workspace/aic-core/src/aiconfigurator_core/systems/
COPY aic-core/src/aiconfigurator_core/systems/data/ /workspace/aic-core/src/aiconfigurator_core/systems/data/

# Set environment variables for SGLang
ENV FLASHINFER_LOG_LEVEL=ERROR
ENV SGLANG_LOAD_FORMAT=dummy
ENV COLLECTOR_LOG_DIR=/workspace/collector/logs

WORKDIR /workspace/collector

CMD ["/bin/bash"]

# ============================================================================
# TensorRT-LLM Collector
# ============================================================================
FROM nvcr.io/nvidia/tensorrt-llm/release:1.3.0rc10 AS collector-trtllm

WORKDIR /workspace

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends git curl && \
    rm -rf /var/lib/apt/lists/*

# Install uv for Python package management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Copy collector source code
COPY collector/ /workspace/collector/

# Copy system definitions
COPY aic-core/src/aiconfigurator_core/systems/*.yaml /workspace/aic-core/src/aiconfigurator_core/systems/
COPY aic-core/src/aiconfigurator_core/systems/data/ /workspace/aic-core/src/aiconfigurator_core/systems/data/

# Set environment variables for TRT-LLM
ENV TLLM_LOG_LEVEL=ERROR
ENV TRTLLM_DG_ENABLED=1
ENV COLLECTOR_LOG_DIR=/workspace/collector/logs

WORKDIR /workspace/collector

CMD ["/bin/bash"]

# ============================================================================
# vLLM Collector
# ============================================================================
FROM vllm/vllm-openai:v0.24.0 AS collector-vllm

WORKDIR /workspace

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends git curl && \
    rm -rf /var/lib/apt/lists/*

# Install uv for Python package management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Copy collector source code
COPY collector/ /workspace/collector/

# Copy system definitions
COPY aic-core/src/aiconfigurator_core/systems/*.yaml /workspace/aic-core/src/aiconfigurator_core/systems/
COPY aic-core/src/aiconfigurator_core/systems/data/ /workspace/aic-core/src/aiconfigurator_core/systems/data/

# Set environment variables for vLLM
ENV COLLECTOR_LOG_DIR=/workspace/collector/logs

WORKDIR /workspace/collector

CMD ["/bin/bash"]
